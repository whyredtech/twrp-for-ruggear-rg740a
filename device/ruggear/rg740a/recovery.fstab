/boot       emmc  /dev/block/bootdevice/by-name/boot
/recovery   emmc  /dev/block/bootdevice/by-name/recovery
/misc       emmc  /dev/block/bootdevice/by-name/misc
/system     ext4  /dev/block/bootdevice/by-name/system     flags=display="System"
/data       ext4  /dev/block/bootdevice/by-name/userdata   flags=display="Data";wipeingui;encryptable=footer
/cache      ext4  /dev/block/bootdevice/by-name/cache
/persist    ext4  /dev/block/bootdevice/by-name/persist    flags=display="Persist"
/modem      vfat  /dev/block/bootdevice/by-name/modem      flags=display="Modem";backup=1
/oem        ext4  /dev/block/bootdevice/by-name/oem        flags=display="OEM"
/external_sd vfat /dev/block/mmcblk1p1 /dev/block/mmcblk1  flags=display="Micro SD";storage;wipeingui;removable
/usb_otg    auto  /dev/block/sda1 /dev/block/sda           flags=display="USB OTG";storage;wipeingui;removable
